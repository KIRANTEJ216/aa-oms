rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // Helper Functions
    // ============================================================
    
    // Get current user's tenant from auth token
    function getTenantId() {
      return request.auth.token.tenant_id;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function getUserId() {
      return request.auth.uid;
    }
    
    function getUserEmail() {
      return request.auth.token.email;
    }
    
    // Check if user has admin role
    function isAdmin() {
      return getUserRole() in ['Super Admin', 'Firm Admin'];
    }
    
    function isPartnerOrAbove() {
      return getUserRole() in ['Super Admin', 'Firm Admin', 'Partner'];
    }
    
    function isManagerOrAbove() {
      return getUserRole() in ['Super Admin', 'Firm Admin', 'Partner', 'Manager'];
    }
    
    // Check if user owns the resource
    function isOwner(resource) {
      return resource.data.created_by == getUserId() 
          || resource.data.assignee_id == getUserId()
          || resource.data.owner_id == getUserId();
    }
    
    // Check if user is in same tenant as resource
    function sameTenant(resource) {
      return resource.data.tenant_id == getTenantId();
    }
    
    // Validate tenant isolation
    function validateTenant() {
      return request.auth != null && getTenantId() != null;
    }
    
    // ============================================================
    // Users Collection
    // ============================================================
    
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read all users in their tenant
      allow read: if validateTenant() 
        && (getUserId() == userId || isAdmin())
        && sameTenant(resource);
      
      // Users can update their own profile (limited fields)
      // Admins can update any user in their tenant
      allow update: if validateTenant()
        && sameTenant(resource)
        && (getUserId() == userId || isAdmin())
        && !("role" in request.resource.data.keys() || getUserId() != userId); // Only admins can change roles
      
      // Only admins can create users (registration goes through auth endpoint)
      allow create: if validateTenant() && isAdmin() && request.resource.data.tenant_id == getTenantId();
      
      // Only admins can delete users
      allow delete: if validateTenant() && isAdmin() && sameTenant(resource);
      
      // Subcollection: passwordHistory - only admins and system can read
      match /passwordHistory/{historyId} {
        allow read: if validateTenant() && isAdmin();
        allow write: if false; // Only via backend
      }
      
      // Subcollection: sessions - user can read own, admins can read all
      match /sessions/{sessionId} {
        allow read: if validateTenant() 
          && (resource.data.user_id == getUserId() || isAdmin())
          && sameTenant(resource);
        allow write: if validateTenant() && sameTenant(resource) 
          && (getUserId() == resource.data.user_id || isAdmin());
      }
    }
    
    // ============================================================
    // Clients Collection
    // ============================================================
    
    match /clients/{clientId} {
      allow read: if validateTenant() 
        && (isManagerOrAbove() 
            || (getUserRole() == 'Article Assistant' && isOwner(resource))
            || (getUserRole() == 'Paid Assistant' && isOwner(resource)))
        && sameTenant(resource);
      
      allow create: if validateTenant() 
        && isManagerOrAbove()
        && request.resource.data.tenant_id == getTenantId();
      
      allow update: if validateTenant() 
        && isManagerOrAbove()
        && sameTenant(resource);
      
      allow delete: if validateTenant() 
        && isAdmin()
        && sameTenant(resource);
    }
    
    // ============================================================
    // Tasks Collection
    // ============================================================
    
    match /tasks/{taskId} {
      allow read: if validateTenant() 
        && (isManagerOrAbove() 
            || (getUserRole() == 'Article Assistant' && isOwner(resource))
            || (getUserRole() == 'Paid Assistant' && isOwner(resource)))
        && sameTenant(resource);
      
      allow create: if validateTenant() 
        && isManagerOrAbove()
        && request.resource.data.tenant_id == getTenantId();
      
      allow update: if validateTenant() 
        && (isManagerOrAbove() 
            || (getUserRole() in ['Article Assistant', 'Paid Assistant'] && isOwner(resource)))
        && sameTenant(resource);
      
      allow delete: if validateTenant() 
        && isAdmin()
        && sameTenant(resource);
    }
    
    // ============================================================
    // Compliance Collection
    // ============================================================
    
    match /compliance/{complianceId} {
      allow read: if validateTenant() 
        && isManagerOrAbove()
        && sameTenant(resource);
      
      allow create: if validateTenant() 
        && isManagerOrAbove()
        && request.resource.data.tenant_id == getTenantId();
      
      allow update: if validateTenant() 
        && isManagerOrAbove()
        && sameTenant(resource);
      
      allow delete: if validateTenant() 
        && isAdmin()
        && sameTenant(resource);
    }
    
    // ============================================================
    // Documents Collection
    // ============================================================
    
    match /documents/{documentId} {
      allow read: if validateTenant() 
        && (isManagerOrAbove() 
            || (getUserRole() == 'Article Assistant' && isOwner(resource)))
        && sameTenant(resource);
      
      allow create: if validateTenant() 
        && isManagerOrAbove()
        && request.resource.data.tenant_id == getTenantId();
      
      allow update: if validateTenant() 
        && isManagerOrAbove()
        && sameTenant(resource);
      
      allow delete: if validateTenant() 
        && isAdmin()
        && sameTenant(resource);
    }
    
    match /documents/{documentId}/versions/{versionId} {
      allow read: if validateTenant() 
        && (isManagerOrAbove() || isOwner(resource))
        && sameTenant(resource);
      allow write: if false; // Only via backend API
    }
    
    // ============================================================
    // Credentials Collection
    // ============================================================
    
    match /credentials/{credentialId} {
      allow read: if validateTenant() 
        && isManagerOrAbove()
        && sameTenant(resource);
      
      allow create: if validateTenant() 
        && isManagerOrAbove()
        && request.resource.data.tenant_id == getTenantId();
      
      allow update: if validateTenant() 
        && isManagerOrAbove()
        && sameTenant(resource);
      
      allow delete: if validateTenant() 
        && isAdmin()
        && sameTenant(resource);
    }
    
    match /credentials/{credentialId}/accessLogs/{logId} {
      allow read: if validateTenant() && isAdmin() && sameTenant(resource);
      allow write: if false; // Only via backend API
    }
    
    // ============================================================
    // Billing / Invoices Collection
    // ============================================================
    
    match /invoices/{invoiceId} {
      allow read: if validateTenant() 
        && (isPartnerOrAbove() 
            || (getUserRole() == 'Manager' && isOwner(resource))
            || (getUserRole() == 'Client' && resource.data.client_id == getClientId()))
        && sameTenant(resource);
      
      allow create: if validateTenant() 
        && isPartnerOrAbove()
        && request.resource.data.tenant_id == getTenantId();
      
      allow update: if validateTenant() 
        && isPartnerOrAbove()
        && sameTenant(resource);
      
      allow delete: if validateTenant() 
        && isAdmin()
        && sameTenant(resource);
    }
    
    match /payments/{paymentId} {
      allow read: if validateTenant() && isPartnerOrAbove() && sameTenant(resource);
      allow create: if validateTenant() && isPartnerOrAbove() && request.resource.data.tenant_id == getTenantId();
      allow update: if false;
      allow delete: if false;
    }
    
    // ============================================================
    // Business Development (BD) Collection
    // ============================================================
    
    match /bd/leads/{leadId} {
      allow read: if validateTenant() 
        && (isPartnerOrAbove() 
            || (getUserRole() == 'Manager' && isOwner(resource)))
        && sameTenant(resource);
      
      allow create: if validateTenant() 
        && isPartnerOrAbove()
        && request.resource.data.tenant_id == getTenantId();
      
      allow update: if validateTenant() 
        && isPartnerOrAbove()
        && sameTenant(resource);
      
      allow delete: if validateTenant() 
        && isAdmin()
        && sameTenant(resource);
    }
    
    match /bd/leads/{leadId}/followups/{followupId} {
      allow read: if validateTenant() && isPartnerOrAbove() && sameTenant(resource);
      allow create: if validateTenant() && isPartnerOrAbove() && request.resource.data.tenant_id == getTenantId();
      allow update: if validateTenant() && isPartnerOrAbove() && sameTenant(resource);
      allow delete: if validateTenant() && isAdmin() && sameTenant(resource);
    }
    
    // ============================================================
    // Support Tickets Collection
    // ============================================================
    
    match /support_tickets/{ticketId} {
      allow read: if validateTenant() 
        && (isManagerOrAbove() 
            || isOwner(resource))
        && sameTenant(resource);
      
      allow create: if validateTenant() 
        && request.resource.data.tenant_id == getTenantId(); // All authenticated users can create
      
      allow update: if validateTenant() 
        && (isManagerOrAbove() || isOwner(resource))
        && sameTenant(resource);
      
      allow delete: if validateTenant() 
        && isAdmin()
        && sameTenant(resource);
    }
    
    // ============================================================
    // Audit Logs Collection (Read-only for admins)
    // ============================================================
    
    match /auditLogs/{logId} {
      allow read: if validateTenant() && isAdmin() && sameTenant(resource);
      allow write: if false; // Only via backend middleware
    }
    
    // ============================================================
    // API Keys Collection (Admin only)
    // ============================================================
    
    match /apiKeys/{keyId} {
      allow read: if validateTenant() && isAdmin() && sameTenant(resource);
      allow create: if false; // Only via backend API
      allow update: if false; // Only via backend API
      allow delete: if false; // Only via backend API
    }
    
    // ============================================================
    // Email Verification Tokens (System only)
    // ============================================================
    
    match /emailVerificationTokens/{tokenId} {
      allow read, write: if false; // Only via backend API
    }
    
    // ============================================================
    // Password Reset Tokens (System only)
    // ============================================================
    
    match /passwordResetTokens/{tokenId} {
      allow read, write: if false; // Only via backend API
    }
    
    // ============================================================
    // User Sessions (User can manage own, admins can manage all)
    // ============================================================
    
    match /userSessions/{sessionId} {
      allow read: if validateTenant() 
        && (resource.data.user_id == getUserId() || isAdmin())
        && sameTenant(resource);
      allow update: if validateTenant() 
        && (resource.data.user_id == getUserId() || isAdmin())
        && sameTenant(resource);
      allow delete: if validateTenant() 
        && (resource.data.user_id == getUserId() || isAdmin())
        && sameTenant(resource);
    }
    
    // ============================================================
    // Reports Collection (Partner+ only)
    // ============================================================
    
    match /reports/{reportId} {
      allow read: if validateTenant() && isPartnerOrAbove() && sameTenant(resource);
      allow write: if false; // Only via backend API
    }
    
    // ============================================================
    // Settings Collection (Admin only)
    // ============================================================
    
    match /settings/{settingId} {
      allow read: if validateTenant() && isAdmin() && sameTenant(resource);
      allow write: if validateTenant() && isAdmin() && request.resource.data.tenant_id == getTenantId();
    }
    
    // ============================================================
    // Default deny for any unmatched collections
    // ============================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


// ============================================================
// Storage Security Rules (for GCS)
// ============================================================

/*
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tenant-scoped paths: tenants/{tenantId}/...
    match /tenants/{tenantId}/{allPaths=**} {
      // Authenticated users in same tenant can read
      allow read: if request.auth != null 
        && request.auth.token.tenant_id == tenantId;
      
      // Managers+ can write
      allow write: if request.auth != null 
        && request.auth.token.tenant_id == tenantId
        && request.auth.token.role in ['Super Admin', 'Firm Admin', 'Partner', 'Manager'];
      
      // Only admins can delete
      allow delete: if request.auth != null 
        && request.auth.token.tenant_id == tenantId
        && request.auth.token.role in ['Super Admin', 'Firm Admin'];
    }
    
    // Public files (if any) - restricted
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
*/