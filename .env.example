# CAOMS — copy to .env and fill
# ── Tenant Mode ──────────────────────────────────────────────
# multi = per-firm SaaS; single = one-firm pilot (pins aarav-advisors)
TENANT_MODE=multi
SEED_TENANT_SLUG=aarav-advisors
SEED_TENANT_NAME=Aarav Advisors
# Seed user credentials — `make seed` reads these. Leave a password blank to
# auto-generate it (printed to console); leave an email blank to skip that role.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_PARTNER_EMAIL=
SEED_PARTNER_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_ARTICLE_EMAIL=
SEED_ARTICLE_PASSWORD=
SEED_PAID_EMAIL=
SEED_PAID_PASSWORD=
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=
# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TENANT_MODE=multi
NEXT_PUBLIC_APP_NAME=CAOMS
# ── Backend ──────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=caoms-dev
FIRESTORE_LOCATION=asia-south1
FIRESTORE_EMULATOR_HOST=localhost:8080
GCS_BUCKET=caoms-docs-dev
GCS_EMULATOR_HOST=http://localhost:4443
SECRET_MANAGER_PROJECT=caoms-dev
JWT_SECRET=change-me-32-chars-minimum-jwt-secret-dev-only
JWT_ACCESS_TTL_MIN=480
JWT_REFRESH_TTL_DAYS=7
# ── Firebase Auth (hybrid) ────────────────────────────────────────
# Service account from Firebase console > Project settings > Service accounts
# > Generate new private key. NEVER commit the private key.
FIREBASE_PROJECT_ID=aa-oms
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@aa-oms.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=
# Frontend Firebase web config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aa-oms.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aa-oms
NEXT_PUBLIC_FIREBASE_APP_ID=
REDIS_URL=redis://localhost:6379/0
# ── Vault (Hashicorp fallback for local) ─────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
# ── Redis Session ────────────────────────────────────────────
SESSION_TTL_DAYS=7
# ── Firestore Emulator ────────────────────────────────────────
FIRESTORE_EMULATOR_PORT=8080
# ── API ──────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000
# ── n8n ──────────────────────────────────────────────────────
N8N_HOST=http://localhost:5678
